(program bab18_03_linked_list_tambah
  (type PSimpul = (^ TSimpul))
  (type TSimpul = (record (Data: Integer) (Berikut: PSimpul)))
  (procedure TambahDepan (var Awal: PSimpul; Nilai: Integer)
    (var (Baru) PSimpul)
    (begin
      (do (call New Baru))
      (:= (. (^ Baru) Data) Nilai)
      (:= (. (^ Baru) Berikut) Awal)
      (:= Awal Baru)
      (empty)))
  (procedure TambahBelakang (var Awal: PSimpul; Nilai: Integer)
    (var (Baru P) PSimpul)
    (begin
      (do (call New Baru))
      (:= (. (^ Baru) Data) Nilai)
      (:= (. (^ Baru) Berikut) nil)
      (if (= Awal nil)
        (:= Awal Baru)
        (else
          (begin
            (:= P Awal)
            (while (<> (. (^ P) Berikut) nil)
              (:= P (. (^ P) Berikut)))
            (:= (. (^ P) Berikut) Baru)
            (empty))))
      (empty)))
  (procedure Tampilkan (Awal: PSimpul)
    (var (P) PSimpul)
    (begin
      (do (call Write 'Awal -> '))
      (:= P Awal)
      (while (<> P nil)
        (begin
          (do (call Write (. (^ P) Data) ' -> '))
          (:= P (. (^ P) Berikut))
          (empty)))
      (do (call WriteLn 'nil'))
      (empty)))
  (procedure HapusSemua (var Awal: PSimpul)
    (var (P) PSimpul)
    (begin
      (while (<> Awal nil)
        (begin
          (:= P Awal)
          (:= Awal (. (^ Awal) Berikut))
          (do (call Dispose P))
          (empty)))
      (empty)))
  (var (Daftar) PSimpul)
  (begin
    (:= Daftar nil)
    (do (call Tampilkan Daftar))
    (do (call TambahBelakang Daftar 12))
    (do (call Tampilkan Daftar))
    (do (call TambahBelakang Daftar 8))
    (do (call Tampilkan Daftar))
    (do (call TambahDepan Daftar 5))
    (do (call Tampilkan Daftar))
    (do (call TambahDepan Daftar 1))
    (do (call Tampilkan Daftar))
    (do (call HapusSemua Daftar))
    (do (call Tampilkan Daftar))
    (empty)))
