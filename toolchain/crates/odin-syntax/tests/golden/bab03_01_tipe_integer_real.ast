(program bab03_01_tipe_integer_real
  (var (JumlahSiswa) Integer)
  (var (Penduduk) LongInt)
  (var (TinggiBadan) Real)
  (var (RataRata) Real)
  (begin
    (:= JumlahSiswa 32)
    (:= Penduduk 2750000)
    (:= TinggiBadan 165.5)
    (do (call WriteLn 'Jumlah siswa : ' JumlahSiswa))
    (do (call WriteLn 'Penduduk     : ' Penduduk))
    (do (call WriteLn 'Tinggi badan : ' TinggiBadan:0:1 ' cm'))
    (:= RataRata (/ 100 JumlahSiswa))
    (do (call WriteLn '100 / 32     = ' RataRata:0:4))
    (:= TinggiBadan JumlahSiswa)
    (do (call WriteLn 'Integer jadi Real   : ' TinggiBadan:0:2))
    (:= JumlahSiswa (call Trunc 165.9))
    (do (call WriteLn 'Trunc(165.9)        : ' JumlahSiswa))
    (:= JumlahSiswa (call Round 165.9))
    (do (call WriteLn 'Round(165.9)        : ' JumlahSiswa))
    (empty)))
