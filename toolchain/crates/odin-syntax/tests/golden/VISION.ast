(program VisionDemo
  (uses Objects Drivers Views Menus Dialogs App MsgBox Editors)
  (const cmCatatan = 100)
  (const cmDialog = 101)
  (const cmTentang = 102)
  (type TDemo = (object (TApplication) (Nomor: Integer) (procedure HandleEvent (var Event: TEvent) [virtual]) (procedure InitMenuBar [virtual]) (procedure InitStatusLine [virtual]) (procedure Catatan) (procedure Dialog)))
  (procedure TDemo.Catatan
    (var (R) TRect)
    (var (W) PEditWindow)
    (begin
      (do (call Inc Nomor))
      (do (call (. R Assign) (* Nomor 2) Nomor (+ (* Nomor 2) 44) (+ Nomor 12)))
      (:= W (call New PEditWindow (call Init R '' Nomor)))
      (do (call InsertWindow W))
      (empty)))
  (procedure TDemo.Dialog
    (var (D) PDialog)
    (var (R) TRect)
    (var (Nama) PInputLine)
    (var (Gaya) PCheckBoxes)
    (var (Ukuran) PRadioButtons)
    (var (Pesan) string)
    (begin
      (do (call (. R Assign) 0 0 46 14))
      (:= D (call New PDialog (call Init R 'Data')))
      (:= (. (^ D) Options) (or (. (^ D) Options) ofCentered))
      (do (call (. R Assign) 12 2 40 3))
      (:= Nama (call New PInputLine (call Init R 30)))
      (do (call (. (^ D) Insert) Nama))
      (do (call (. R Assign) 2 2 11 3))
      (do (call (. (^ D) Insert) (call New PLabel (call Init R '~N~ama' Nama))))
      (do (call (. R Assign) 3 5 21 8))
      (:= Gaya (call New PCheckBoxes (call Init R (call NewSItem '~T~ebal' (call NewSItem '~M~iring' (call NewSItem '~G~aris' nil))))))
      (do (call (. (^ D) Insert) Gaya))
      (do (call (. R Assign) 2 4 12 5))
      (do (call (. (^ D) Insert) (call New PLabel (call Init R '~G~aya' Gaya))))
      (do (call (. R Assign) 24 5 42 8))
      (:= Ukuran (call New PRadioButtons (call Init R (call NewSItem '~K~ecil' (call NewSItem '~S~edang' (call NewSItem '~B~esar' nil))))))
      (do (call (. (^ D) Insert) Ukuran))
      (do (call (. R Assign) 23 4 33 5))
      (do (call (. (^ D) Insert) (call New PLabel (call Init R '~U~kuran' Ukuran))))
      (do (call (. R Assign) 11 10 21 12))
      (do (call (. (^ D) Insert) (call New PButton (call Init R 'O~K~' cmOK bfDefault))))
      (do (call (. R Assign) 24 10 34 12))
      (do (call (. (^ D) Insert) (call New PButton (call Init R 'Batal' cmCancel bfNormal))))
      (do (call (. (^ D) SelectNext) False))
      (if (= (call (. (^ Desktop) ExecView) D) cmOK)
        (begin
          (:= Pesan (+ (+ 'Halo, ' (^ (. (^ Nama) Data))) '!'))
          (if (call (. (^ Gaya) Mark) 0)
            (:= Pesan (+ Pesan ' Tebal.')))
          (if (= (. (^ Ukuran) Value) 2)
            (:= Pesan (+ Pesan ' Besar.')))
          (do (call MessageBox (+ #3 Pesan) nil (+ mfInformation mfOKButton)))
          (empty)))
      (do (call Dispose D Done))
      (empty)))
  (procedure TDemo.HandleEvent (var Event: TEvent)
    (begin
      (do (call (inherited HandleEvent) Event))
      (if (= (. Event What) evCommand)
        (begin
          (case (. Event Command)
            (arm cmCatatan
              (do Catatan))
            (arm cmDialog
              (do Dialog))
            (arm cmTentang
              (do (call MessageBox #3'Demo Turbo Vision'#13#3'Odin Turbo Pascal' nil (+ mfInformation mfOKButton))))
            (else
              (do Exit)
              (empty)))
          (do (call ClearEvent Event))
          (empty)))
      (empty)))
  (procedure TDemo.InitMenuBar
    (var (R) TRect)
    (begin
      (do (call GetExtent R))
      (:= (. (. R B) Y) (+ (. (. R A) Y) 1))
      (:= MenuBar (call New PMenuBar (call Init R (call NewMenu (call NewSubMenu '~F~ile' hcNoContext (call NewMenu (call NewItem '~N~ew window' 'F4' kbF4 cmCatatan hcNoContext (call NewItem '~D~ialog...' 'F3' kbF3 cmDialog hcNoContext (call NewLine (call NewItem 'E~x~it' 'Alt+X' kbAltX cmQuit hcNoContext nil))))) (call NewSubMenu '~W~indow' hcNoContext (call NewMenu (call NewItem '~T~ile' '' kbNoKey cmTile hcNoContext (call NewItem 'C~a~scade' '' kbNoKey cmCascade hcNoContext (call NewItem '~N~ext' 'F6' kbF6 cmNext hcNoContext (call NewItem '~C~lose' 'Alt+F3' kbAltF3 cmClose hcNoContext nil))))) (call NewSubMenu '~H~elp' hcNoContext (call NewMenu (call NewItem '~A~bout...' '' kbNoKey cmTentang hcNoContext nil)) nil)))))))
      (empty)))
  (procedure TDemo.InitStatusLine
    (var (R) TRect)
    (begin
      (do (call GetExtent R))
      (:= (. (. R A) Y) (- (. (. R B) Y) 1))
      (:= StatusLine (call New PStatusLine (call Init R (call NewStatusDef 0 65535 (call NewStatusKey '~Alt+X~ Exit' kbAltX cmQuit (call NewStatusKey '~F4~ New' kbF4 cmCatatan (call NewStatusKey '~F3~ Dialog' kbF3 cmDialog (call NewStatusKey '~F10~ Menu' kbF10 cmMenu (call NewStatusKey '' kbF6 cmNext (call NewStatusKey '' kbAltF3 cmClose nil)))))) nil))))
      (empty)))
  (var (Demo) TDemo)
  (begin
    (do (. Demo Init))
    (:= EditorDialog StdEditorDialog)
    (do (. Demo Catatan))
    (do (. Demo Run))
    (do (. Demo Done))
    (do (call WriteLn 'Demo Turbo Vision selesai.'))
    (empty)))
