(program Kalkulator
  (var (A B) Real)
  (var (Pilihan) Integer)
  (begin
    (do (call WriteLn 'KALKULATOR PASCAL'))
    (do (call Write 'Bilangan pertama: '))
    (do (call ReadLn A))
    (do (call Write 'Bilangan kedua  : '))
    (do (call ReadLn B))
    (do (call WriteLn '1. Tambah  2. Kurang  3. Kali  4. Bagi'))
    (do (call Write 'Pilihan: '))
    (do (call ReadLn Pilihan))
    (case Pilihan
      (arm 1
        (do (call WriteLn 'Hasil: ' (+ A B):0:2)))
      (arm 2
        (do (call WriteLn 'Hasil: ' (- A B):0:2)))
      (arm 3
        (do (call WriteLn 'Hasil: ' (* A B):0:2)))
      (arm 4
        (if (= B 0)
          (do (call WriteLn 'Pembagi tidak boleh nol.'))
          (else
            (do (call WriteLn 'Hasil: ' (/ A B):0:2)))))
      (else
        (do (call WriteLn 'Pilihan tidak tersedia.'))
        (empty)))
    (empty)))
