(program bab07_06_menu_berulang
  (var (Pilihan) Integer)
  (var (Celsius Fahrenheit Kilometer) Real)
  (begin
    (repeat-until (= Pilihan 0)
      (do WriteLn)
      (do (call WriteLn '=== KONVERSI SATUAN ==='))
      (do (call WriteLn '1. Celsius ke Fahrenheit'))
      (do (call WriteLn '2. Fahrenheit ke Celsius'))
      (do (call WriteLn '3. Kilometer ke mil'))
      (do (call WriteLn '0. Keluar'))
      (do (call Write 'Pilihan: '))
      (do (call ReadLn Pilihan))
      (case Pilihan
        (arm 1
          (begin
            (do (call Write 'Suhu Celsius   : '))
            (do (call ReadLn Celsius))
            (do (call WriteLn 'Hasil          : ' (+ (/ (* Celsius 9) 5) 32):0:1 ' F'))
            (empty)))
        (arm 2
          (begin
            (do (call Write 'Suhu Fahrenheit: '))
            (do (call ReadLn Fahrenheit))
            (do (call WriteLn 'Hasil          : ' (/ (* (- Fahrenheit 32) 5) 9):0:1 ' C'))
            (empty)))
        (arm 3
          (begin
            (do (call Write 'Jarak (km)     : '))
            (do (call ReadLn Kilometer))
            (do (call WriteLn 'Hasil          : ' (* Kilometer 0.621371):0:2 ' mil'))
            (empty)))
        (arm 0
          (do (call WriteLn 'Terima kasih!')))
        (else
          (do (call WriteLn 'Pilihan tidak tersedia.'))
          (empty)))
      (empty))
    (empty)))
