(program bab07_04_repeat_until
  (var (Nilai) Integer)
  (var (Jawab) Char)
  (var (Ulang) Integer)
  (begin
    (repeat-until (and (>= Nilai 0) (<= Nilai 100))
      (do (call Write 'Masukkan nilai (0-100): '))
      (do (call ReadLn Nilai))
      (if (or (< Nilai 0) (> Nilai 100))
        (do (call WriteLn '  Nilai tidak sah, coba lagi.')))
      (empty))
    (do (call WriteLn 'Nilai diterima: ' Nilai))
    (do WriteLn)
    (:= Ulang 0)
    (repeat-until (or (= Jawab 'T') (= Jawab 't'))
      (:= Ulang (+ Ulang 1))
      (do (call WriteLn 'Putaran ke-' Ulang))
      (do (call Write 'Lanjut (Y/T)? '))
      (do (call ReadLn Jawab))
      (empty))
    (do (call WriteLn 'Selesai setelah ' Ulang ' putaran.'))
    (empty)))
