(program bab05_04_operator_logika
  (var (P Q) Boolean)
  (var (Umur) Integer)
  (var (PunyaTiket) Boolean)
  (begin
    (do (call WriteLn '    P      Q  P and Q  P or Q  P xor Q'))
    (:= P True)
    (:= Q True)
    (do (call WriteLn P:5 Q:7 (and P Q):9 (or P Q):8 (xor P Q):9))
    (:= P True)
    (:= Q False)
    (do (call WriteLn P:5 Q:7 (and P Q):9 (or P Q):8 (xor P Q):9))
    (:= P False)
    (:= Q True)
    (do (call WriteLn P:5 Q:7 (and P Q):9 (or P Q):8 (xor P Q):9))
    (:= P False)
    (:= Q False)
    (do (call WriteLn P:5 Q:7 (and P Q):9 (or P Q):8 (xor P Q):9))
    (do (call WriteLn 'not True = ' (not True)))
    (do WriteLn)
    (:= Umur 15)
    (:= PunyaTiket True)
    (do (call WriteLn 'Boleh masuk (umur >= 13 dan punya tiket)? ' (and (>= Umur 13) PunyaTiket)))
    (do (call WriteLn 'Dapat diskon (umur < 12 atau umur > 60)?  ' (or (< Umur 12) (> Umur 60))))
    (empty)))
