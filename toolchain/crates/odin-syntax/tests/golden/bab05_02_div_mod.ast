(program bab05_02_div_mod
  (var (TotalDetik) LongInt)
  (var (Jam Menit Detik) LongInt)
  (var (Angka) Integer)
  (begin
    (do (call WriteLn '17 div 5 = ' (div 17 5)))
    (do (call WriteLn '17 mod 5 = ' (mod 17 5)))
    (do WriteLn)
    (do (call Write 'Masukkan jumlah detik: '))
    (do (call ReadLn TotalDetik))
    (:= Jam (div TotalDetik 3600))
    (:= Menit (div (mod TotalDetik 3600) 60))
    (:= Detik (mod TotalDetik 60))
    (do (call WriteLn TotalDetik ' detik = ' Jam ' jam ' Menit ' menit ' Detik ' detik'))
    (do WriteLn)
    (do (call Write 'Masukkan sebuah bilangan bulat: '))
    (do (call ReadLn Angka))
    (do (call WriteLn 'Sisa bagi 2 = ' (mod Angka 2)))
    (do (call WriteLn 'Angka satuan = ' (mod Angka 10)))
    (do (call WriteLn 'Tanpa satuan = ' (div Angka 10)))
    (empty)))
