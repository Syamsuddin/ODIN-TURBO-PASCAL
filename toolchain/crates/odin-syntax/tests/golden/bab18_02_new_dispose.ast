(program bab18_02_new_dispose
  (type PSiswa = (^ TSiswa))
  (type TSiswa = (record (Nama: string[20]) (Nilai: Integer)))
  (var (PAngka) (^ Integer))
  (var (A B) PSiswa)
  (begin
    (do (call New PAngka))
    (:= (^ PAngka) 2026)
    (do (call WriteLn 'Isi memori baru: ' (^ PAngka)))
    (do (call Dispose PAngka))
    (:= PAngka nil)
    (do (call New A))
    (:= (. (^ A) Nama) 'Rudi')
    (:= (. (^ A) Nilai) 81)
    (do (call New B))
    (:= (^ B) (^ A))
    (:= (. (^ B) Nama) 'Sari')
    (do (call WriteLn (. (^ A) Nama) ': ' (. (^ A) Nilai)))
    (do (call WriteLn (. (^ B) Nama) ': ' (. (^ B) Nilai)))
    (do (call Dispose A))
    (do (call Dispose B))
    (do (call WriteLn 'Memori sudah dikembalikan.'))
    (empty)))
