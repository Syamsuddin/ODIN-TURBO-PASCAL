(program bab05_01_operator_aritmetika
  (var (A B) Integer)
  (var (X Y) Real)
  (begin
    (:= A 17)
    (:= B 5)
    (do (call WriteLn 'A = ' A ', B = ' B))
    (do (call WriteLn 'A + B = ' (+ A B)))
    (do (call WriteLn 'A - B = ' (- A B)))
    (do (call WriteLn 'A * B = ' (* A B)))
    (do (call WriteLn 'A / B = ' (/ A B):0:2))
    (do (call WriteLn '-A    = ' (neg A)))
    (do WriteLn)
    (:= X 7.5)
    (:= Y 2.5)
    (do (call WriteLn 'X = ' X:0:1 ', Y = ' Y:0:1))
    (do (call WriteLn 'X + Y = ' (+ X Y):0:2))
    (do (call WriteLn 'X * Y = ' (* X Y):0:2))
    (do (call WriteLn 'X / Y = ' (/ X Y):0:2))
    (do (call WriteLn 'A + X = ' (+ A X):0:2))
    (do (call WriteLn 'Sqr(B)   = ' (call Sqr B)))
    (do (call WriteLn 'Sqrt(81) = ' (call Sqrt 81):0:1))
    (do (call WriteLn 'Abs(-12) = ' (call Abs (neg 12))))
    (empty)))
