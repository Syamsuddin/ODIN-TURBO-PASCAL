(program bab04_02_read_readln
  (var (Nama) string)
  (var (Umur) Integer)
  (var (Tinggi) Real)
  (var (A B) Integer)
  (begin
    (do (call Write 'Nama Anda   : '))
    (do (call ReadLn Nama))
    (do (call Write 'Umur (tahun): '))
    (do (call ReadLn Umur))
    (do (call Write 'Tinggi (cm) : '))
    (do (call ReadLn Tinggi))
    (do (call Write 'Ketik dua bilangan, pisahkan dengan spasi: '))
    (do (call ReadLn A B))
    (do WriteLn)
    (do (call WriteLn 'Halo, ' Nama '!'))
    (do (call WriteLn 'Tahun depan umur Anda ' (+ Umur 1) ' tahun.'))
    (do (call WriteLn 'Tinggi Anda ' Tinggi:0:1 ' cm.'))
    (do (call WriteLn A ' + ' B ' = ' (+ A B)))
    (empty)))
