start
Exec [/bin/sh] [-c "exit 3"] err 0 code 3
a b c d 'e f' g\h x y z"w q"
Exec [/bin/echo] [a  b "c d" 'e f' g\h "x""y" z"w q"] err 0 code 0

Exec [/bin/echo] [] err 0 code 0
Exec [/no/such/program] [x] err 8 code 127
Exec [/etc/hosts] [x] err 8 code 127
Exec [/bin] [x] err 8 code 127
Exec [/bin/sh] [-c "kill -9 $$"] err 8 code 65527
Exec [/bin/sh] [-c "exit 300"] err 0 code 44
Exec [sh] [-c "exit 4"] err 8 code 127
/bin/sh
Exec [/bin/sh] [-c "echo $0"] err 0 code 0
[B] []
Exec [/bin/sh] [-c "echo  [$1] [$2]" A  B] err 0 code 0
Exec [/bin/sh] [-c "exit 127"] err 8 code 127
Exec [/bin/sh] [-c "test -n \"$HOME\""] err 0 code 0
