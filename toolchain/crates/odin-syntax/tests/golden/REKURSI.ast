(program Rekursi
  (function Faktorial (N: Integer) : LongInt
    (begin
      (if (<= N 1)
        (:= Faktorial 1)
        (else
          (:= Faktorial (* N (call Faktorial (- N 1))))))
      (empty)))
  (var (I) Integer)
  (begin
    (for I 0 to 10
      (do (call WriteLn I:2 '! = ' (call Faktorial I):8)))
    (empty)))
