(program bab05_06_luas_keliling
  (var (Panjang Lebar) Real)
  (var (JariJari) Real)
  (var (Luas Keliling) Real)
  (begin
    (do (call WriteLn 'PERSEGI PANJANG'))
    (do (call Write 'Panjang (cm): '))
    (do (call ReadLn Panjang))
    (do (call Write 'Lebar   (cm): '))
    (do (call ReadLn Lebar))
    (:= Luas (* Panjang Lebar))
    (:= Keliling (* 2 (+ Panjang Lebar)))
    (do (call WriteLn 'Luas     = ' Luas:0:2 ' cm2'))
    (do (call WriteLn 'Keliling = ' Keliling:0:2 ' cm'))
    (do WriteLn)
    (do (call WriteLn 'LINGKARAN'))
    (do (call Write 'Jari-jari (cm): '))
    (do (call ReadLn JariJari))
    (:= Luas (* Pi (call Sqr JariJari)))
    (:= Keliling (* (* 2 Pi) JariJari))
    (do (call WriteLn 'Luas     = ' Luas:0:2 ' cm2'))
    (do (call WriteLn 'Keliling = ' Keliling:0:2 ' cm'))
    (empty)))
