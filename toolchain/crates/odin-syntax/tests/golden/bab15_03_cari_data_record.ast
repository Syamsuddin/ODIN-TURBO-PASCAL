(program bab15_03_cari_data_record
  (type TBarang = (record (Kode: string[4]) (Nama: string[20]) (Harga: LongInt) (Stok: Integer)))
  (const N = 6)
  (const Gudang : (array [(.. 1 N)] TBarang) = ((Kode: 'A001'; Nama: 'Buku tulis'; Harga: 5000; Stok: 120), (Kode: 'A002'; Nama: 'Pensil 2B'; Harga: 3500; Stok: 200), (Kode: 'A003'; Nama: 'Penghapus'; Harga: 2000; Stok: 75), (Kode: 'B001'; Nama: 'Buku gambar'; Harga: 8000; Stok: 40), (Kode: 'B002'; Nama: 'Pensil warna'; Harga: 25000; Stok: 15), (Kode: 'C001'; Nama: 'Penggaris 30'; Harga: 4500; Stok: 60)))
  (function Kapital (S: string) : string
    (var (I) Integer)
    (begin
      (for I 1 to (call Length S)
        (:= (index S I) (call UpCase (index S I))))
      (:= Kapital S)
      (empty)))
  (procedure Tampilkan (I: Integer)
    (begin
      (with (index Gudang I)
        (do (call WriteLn '  ' Kode '  ' Nama '':(- 14 (call Length Nama)) 'Rp' Harga:7 '  stok ' Stok)))
      (empty)))
  (var (Kode Kata) string)
  (var (I Posisi Banyak) Integer)
  (begin
    (do (call Write 'Kode barang: '))
    (do (call ReadLn Kode))
    (:= Kode (call Kapital Kode))
    (:= Posisi 0)
    (:= I 1)
    (while (and (<= I N) (= Posisi 0))
      (begin
        (if (= (. (index Gudang I) Kode) Kode)
          (:= Posisi I))
        (:= I (+ I 1))
        (empty)))
    (if (> Posisi 0)
      (do (call Tampilkan Posisi))
      (else
        (do (call WriteLn '  Kode ' Kode ' tidak ditemukan.'))))
    (do (call Write 'Kata kunci nama: '))
    (do (call ReadLn Kata))
    (:= Banyak 0)
    (for I 1 to N
      (if (> (call Pos (call Kapital Kata) (call Kapital (. (index Gudang I) Nama))) 0)
        (begin
          (do (call Tampilkan I))
          (:= Banyak (+ Banyak 1))
          (empty))))
    (do (call WriteLn '  ' Banyak ' barang cocok.'))
    (empty)))
