(program bab17_04_file_bertipe
  (const NamaFile = 'angka.dat')
  (var (F) (file-of LongInt))
  (var (X) LongInt)
  (var (I) Integer)
  (var (Folder) string)
  (begin
    (do (call Assign F NamaFile))
    (do (call Rewrite F))
    (for I 1 to 10
      (begin
        (:= X (* I I))
        (do (call Write F X))
        (empty)))
    (do (call WriteLn 'Ditulis ' (call FileSize F) ' elemen (kuadrat 1 sampai 10).'))
    (do (call Seek F 4))
    (do (call Read F X))
    (do (call WriteLn 'Elemen nomor 4 berisi ' X))
    (do (call WriteLn 'Posisi sekarang: ' (call FilePos F)))
    (do (call Seek F 0))
    (:= X 1000)
    (do (call Write F X))
    (do (call WriteLn 'Isi file sekarang:'))
    (do (call Seek F 0))
    (while (not (call Eof F))
      (begin
        (do (call Read F X))
        (do (call Write X ' '))
        (empty)))
    (do WriteLn)
    (do (call Close F))
    (do (call GetDir 0 Folder))
    (do (call WriteLn 'File ' NamaFile ' ada di folder ' Folder))
    (do (call WriteLn 'Coba buka dengan editor teks: isinya bukan tulisan biasa.'))
    (empty)))
