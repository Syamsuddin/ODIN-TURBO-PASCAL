(program bab12_01_fungsi_string
  (var (Kalimat Kata) string)
  (var (I Posisi) Integer)
  (begin
    (:= Kalimat 'Belajar Pascal itu menyenangkan')
    (do (call WriteLn 'Kalimat   : ' Kalimat))
    (do (call WriteLn 'Panjang   : ' (call Length Kalimat)))
    (do (call WriteLn 'Copy 9..14: ' (call Copy Kalimat 9 6)))
    (:= Posisi (call Pos 'itu' Kalimat))
    (do (call WriteLn 'Pos "itu" : ' Posisi))
    (do (call WriteLn 'Pos "Java": ' (call Pos 'Java' Kalimat)))
    (do (call Insert 'sangat ' Kalimat (call Pos 'menyenangkan' Kalimat)))
    (do (call WriteLn 'Insert    : ' Kalimat))
    (do (call Delete Kalimat 1 8))
    (do (call WriteLn 'Delete    : ' Kalimat))
    (:= Kata Kalimat)
    (for I 1 to (call Length Kata)
      (:= (index Kata I) (call UpCase (index Kata I))))
    (do (call WriteLn 'Kapital   : ' Kata))
    (do (call WriteLn 'Sambung   : ' (call Concat 'Turbo' ' ' 'Pascal') (+ ' ' '7')))
    (empty)))
