(program bab04_04_biodata_sederhana
  (var (Nama Alamat Hobi) string)
  (var (TahunLahir Umur) Integer)
  (var (Tinggi Berat) Real)
  (const TahunIni = 2026)
  (begin
    (do (call WriteLn 'ISI BIODATA'))
    (do (call Write 'Nama lengkap : '))
    (do (call ReadLn Nama))
    (do (call Write 'Alamat       : '))
    (do (call ReadLn Alamat))
    (do (call Write 'Tahun lahir  : '))
    (do (call ReadLn TahunLahir))
    (do (call Write 'Tinggi (cm)  : '))
    (do (call ReadLn Tinggi))
    (do (call Write 'Berat (kg)   : '))
    (do (call ReadLn Berat))
    (do (call Write 'Hobi         : '))
    (do (call ReadLn Hobi))
    (:= Umur (- TahunIni TahunLahir))
    (do WriteLn)
    (do (call WriteLn '+--------------------------------------+'))
    (do (call WriteLn '|            KARTU BIODATA             |'))
    (do (call WriteLn '+--------------------------------------+'))
    (do (call WriteLn '  Nama   : ' Nama))
    (do (call WriteLn '  Alamat : ' Alamat))
    (do (call WriteLn '  Umur   : ' Umur ' tahun'))
    (do (call WriteLn '  Tinggi : ' Tinggi:0:1 ' cm'))
    (do (call WriteLn '  Berat  : ' Berat:0:1 ' kg'))
    (do (call WriteLn '  Hobi   : ' Hobi))
    (do (call WriteLn '+--------------------------------------+'))
    (empty)))
