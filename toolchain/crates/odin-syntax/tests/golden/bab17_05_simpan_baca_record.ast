(program bab17_05_simpan_baca_record
  (const NamaFile = 'siswa.dat')
  (type TSiswa = (record (Nama: string[20]) (Kelas: string[5]) (Nilai: Integer)))
  (var (F) (file-of TSiswa))
  (var (S) TSiswa)
  (var (Nama) string)
  (var (Nomor) Integer)
  (begin
    (do (call Assign F NamaFile))
    (do (call Reset F))
    (if (<> IOResult 0)
      (do (call Rewrite F)))
    (do (call WriteLn 'Data tersimpan saat ini: ' (call FileSize F) ' siswa.'))
    (do (call Seek F (call FileSize F)))
    (do (call WriteLn 'Tambah siswa baru (nama kosong = selesai).'))
    (repeat-until (= Nama '')
      (do (call Write 'Nama  : '))
      (do (call ReadLn Nama))
      (if (<> Nama '')
        (begin
          (:= (. S Nama) Nama)
          (do (call Write 'Kelas : '))
          (do (call ReadLn (. S Kelas)))
          (do (call Write 'Nilai : '))
          (do (call ReadLn (. S Nilai)))
          (do (call Write F S))
          (empty)))
      (empty))
    (do WriteLn)
    (do (call WriteLn 'No  Nama                  Kelas  Nilai'))
    (do (call Seek F 0))
    (:= Nomor 0)
    (while (not (call Eof F))
      (begin
        (do (call Read F S))
        (:= Nomor (+ Nomor 1))
        (do (call WriteLn Nomor:2 '  ' (. S Nama) '':(- 22 (call Length (. S Nama))) (. S Kelas) '':(- 7 (call Length (. S Kelas))) (. S Nilai):5))
        (empty)))
    (do (call Close F))
    (empty)))
