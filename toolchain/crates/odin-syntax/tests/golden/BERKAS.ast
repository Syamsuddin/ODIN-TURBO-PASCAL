(program BerkasTeks
  (var (F) Text)
  (var (Baris NamaFile) string)
  (begin
    (do (call Write 'Nama berkas baru (misal catatan.txt): '))
    (do (call ReadLn NamaFile))
    (do (call Assign F NamaFile))
    (do (call Reset F))
    (if (= IOResult 0)
      (begin
        (do (call Close F))
        (do (call WriteLn 'Berkas sudah ada. Gunakan nama baru agar data tidak tertimpa.'))
        (do (call Halt 1))
        (empty)))
    (do (call Rewrite F))
    (if (<> IOResult 0)
      (begin
        (do (call WriteLn 'Berkas tidak bisa dibuat pada direktori ini.'))
        (do (call Halt 1))
        (empty)))
    (do (call WriteLn F 'Belajar Pascal dengan Odin.'))
    (do (call Close F))
    (do (call Reset F))
    (while (not (call Eof F))
      (begin
        (do (call ReadLn F Baris))
        (do (call WriteLn Baris))
        (empty)))
    (do (call Close F))
    (do (call WriteLn 'Berkas tersimpan: ' NamaFile))
    (empty)))
