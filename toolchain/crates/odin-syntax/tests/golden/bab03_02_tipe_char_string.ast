(program bab03_02_tipe_char_string
  (var (Huruf) Char)
  (var (Nama) string)
  (var (Kota) string[9])
  (var (Kalimat) string)
  (begin
    (:= Huruf 'A')
    (:= Nama 'Budi Santoso')
    (:= Kota 'Kandangan Barat')
    (do (call WriteLn 'Huruf : ' Huruf))
    (do (call WriteLn 'Nama  : ' Nama))
    (do (call WriteLn 'Kota  : ' Kota ' (dipotong menjadi 9 karakter)'))
    (do (call WriteLn 'Kode huruf A   : ' (call Ord Huruf)))
    (do (call WriteLn 'Karakter ke-66 : ' (call Chr 66)))
    (do (call WriteLn 'Huruf pertama nama: ' (index Nama 1)))
    (do (call WriteLn 'Panjang nama      : ' (call Length Nama) ' karakter'))
    (:= Kalimat (+ (+ 'Halo, ' Nama) '! Ini Jum''at yang cerah.'))
    (do (call WriteLn Kalimat))
    (empty)))
