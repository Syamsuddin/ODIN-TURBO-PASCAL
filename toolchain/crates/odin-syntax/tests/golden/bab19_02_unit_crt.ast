(program bab19_02_unit_crt
  (uses Crt)
  (var (I X Y) Integer)
  (var (Tombol) Char)
  (begin
    (do (call TextBackground Blue))
    (do ClrScr)
    (do (call TextColor Yellow))
    (do (call GotoXY 32 2))
    (do (call Write 'BELAJAR UNIT CRT'))
    (do (call TextColor White))
    (do (call GotoXY 5 4))
    (do (call Write 'Enam belas warna teks, nomor 0 sampai 15:'))
    (for I 0 to 15
      (begin
        (do (call TextColor I))
        (do (call GotoXY (+ 5 (* (div I 8) 30)) (+ 6 (mod I 8))))
        (do (call Write 'Warna nomor ' I:2))
        (empty)))
    (do (call TextColor LightCyan))
    (do (call GotoXY 5 16))
    (:= X WhereX)
    (:= Y WhereY)
    (do (call Write 'Kursor ada di kolom ' X ', baris ' Y))
    (do (call TextColor White))
    (do (call GotoXY 5 18))
    (do (call Write 'Memuat: '))
    (for I 1 to 40
      (begin
        (do (call Write '#'))
        (do (call Delay 25))
        (empty)))
    (do (call TextColor LightGreen))
    (do (call GotoXY 5 22))
    (do (call Write 'Tekan sembarang tombol untuk selesai...'))
    (:= Tombol ReadKey)
    (do (call TextColor LightGray))
    (do (call TextBackground Black))
    (do ClrScr)
    (if (= Tombol #0)
      (do (call WriteLn 'Anda menekan tombol khusus, kode ' (call Ord ReadKey)))
      (else
        (do (call WriteLn 'Anda menekan tombol "' Tombol '"'))))
    (do (call WriteLn 'Program selesai.'))
    (empty)))
