(program bab07_03_while_do
  (var (Angka Sisa JumlahDigit) LongInt)
  (var (Bilangan Total Banyak) Integer)
  (begin
    (do (call Write 'Masukkan bilangan bulat positif: '))
    (do (call ReadLn Angka))
    (:= Sisa Angka)
    (:= JumlahDigit 0)
    (while (> Sisa 0)
      (begin
        (:= JumlahDigit (+ JumlahDigit (mod Sisa 10)))
        (:= Sisa (div Sisa 10))
        (empty)))
    (do (call WriteLn 'Jumlah digit ' Angka ' = ' JumlahDigit))
    (do WriteLn)
    (do (call WriteLn 'Ketik beberapa bilangan, akhiri dengan 0.'))
    (:= Total 0)
    (:= Banyak 0)
    (do (call Write 'Bilangan: '))
    (do (call ReadLn Bilangan))
    (while (<> Bilangan 0)
      (begin
        (:= Total (+ Total Bilangan))
        (:= Banyak (+ Banyak 1))
        (do (call Write 'Bilangan: '))
        (do (call ReadLn Bilangan))
        (empty)))
    (do (call WriteLn 'Banyak bilangan: ' Banyak ', jumlahnya: ' Total))
    (empty)))
