(program bab18_01_pointer_dasar
  (type PInteger = (^ Integer))
  (var (X Y) Integer)
  (var (P Q) PInteger)
  (begin
    (:= X 10)
    (:= Y 20)
    (:= P (@ X))
    (do (call WriteLn 'X = ' X ', P^ = ' (^ P)))
    (:= (^ P) 99)
    (do (call WriteLn 'Setelah P^ := 99, X = ' X))
    (:= Q P)
    (:= (^ Q) (+ (^ Q) 1))
    (do (call WriteLn 'Setelah Q^ := Q^ + 1, X = ' X ', P^ = ' (^ P)))
    (:= P (@ Y))
    (do (call WriteLn 'P sekarang menunjuk Y, P^ = ' (^ P)))
    (do (call WriteLn 'P dan Q menunjuk tempat yang sama? ' (= P Q)))
    (:= P nil)
    (if (= P nil)
      (do (call WriteLn 'P bernilai nil. Jangan membaca P^ saat P = nil!')))
    (empty)))
