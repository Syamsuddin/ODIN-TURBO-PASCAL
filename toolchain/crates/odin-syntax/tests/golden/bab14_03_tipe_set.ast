(program bab14_03_tipe_set
  (type THari = (enum Senin Selasa Rabu Kamis Jumat Sabtu Minggu))
  (type TJadwal = (set-of THari))
  (const NamaHari : (array [THari] string[6]) = ('Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu', 'Minggu'))
  (procedure Tampilkan (Judul: string; Jadwal: TJadwal)
    (var (H) THari)
    (begin
      (do (call Write Judul ': '))
      (if (= Jadwal [])
        (do (call Write '(kosong)')))
      (for H Senin to Minggu
        (if (in H Jadwal)
          (do (call Write (index NamaHari H) ' '))))
      (do WriteLn)
      (empty)))
  (var (Andi Budi) TJadwal)
  (begin
    (:= Andi [Senin, Rabu, Jumat])
    (:= Budi [Rabu, Kamis, Jumat, Sabtu])
    (do (call Tampilkan 'Andi          ' Andi))
    (do (call Tampilkan 'Budi          ' Budi))
    (do (call Tampilkan 'Andi + Budi   ' (+ Andi Budi)))
    (do (call Tampilkan 'Andi * Budi   ' (* Andi Budi)))
    (do (call Tampilkan 'Andi - Budi   ' (- Andi Budi)))
    (do (call Include Andi Minggu))
    (do (call Exclude Andi Senin))
    (do (call Tampilkan 'Andi sekarang ' Andi))
    (do (call WriteLn 'Andi latihan hari Sabtu? ' (in Sabtu Andi)))
    (do (call WriteLn '[Rabu, Jumat] bagian dari jadwal Budi? ' (<= [Rabu, Jumat] Budi)))
    (empty)))
